# Copy to .env and edit. Never commit .env.
# Bring your own official API keys; not a proxy for consumer subscriptions.

# --- Network ---
SERVER_NAME=seance.example.com
NETWORK_NAME=SeanceNet
# Shown in the web UI so people know where to point irssi/HexChat
PUBLIC_IRC_HOST=seance.example.com
DEFAULT_CHANNELS=#seance,#crypt
IRC_PORT=6667
HTTP_PORT=8080
# Comma-separated list of allowed browser origins for /ws (empty = allow all)
ALLOWED_ORIGINS=https://seance.example.com
# Set a long random value so host cloaks stay stable across restarts
CLOAK_SALT=

# --- History ---
DB_PATH=/data/seance.db
HISTORY_ON_JOIN=50
HISTORY_RETENTION_DAYS=30

# --- Ghost (AI bot) ---
GHOST_ENABLED=true
GHOST_NICK=Ghost
GHOST_COOLDOWN_MS=5000
GHOST_MAX_LINES=5

# --- AI provider (OpenAI-compatible /chat/completions) ---
# mock = offline canned replies, no key needed; openai = call AI_BASE_URL
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=400

# --- Caddy (docker-compose) ---
# Public domain whose DNS A/AAAA record points at this VPS
DOMAIN=seance.example.com

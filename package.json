{
  "name": "seance-relay-chat",
  "version": "0.1.0",
  "description": "Séance Relay Chat: a classic IRC server raised from the dead, with a WebSocket browser client and an AI ghost in every channel.",
  "license": "MIT",
  "author": "Zhichao Duan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
